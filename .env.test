# Test environment — committed with non-secret values so the suite runs
# out of the box. Integration tests use an in-memory PGlite database, so the
# Postgres credentials below are placeholders that are never connected to.
NODE_ENV=test

POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=test
DB_HOST=localhost
DB_PORT=5432

JWT_SECRET=test-access-secret-not-for-production
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=test-refresh-secret-not-for-production
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_NAME=refreshToken

CORS_ORIGIN=*
PORT=3001
