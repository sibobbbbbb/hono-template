{
  "name": "hono-template",
  "version": "1.0.0",
  "description": "An ultrafast, type-safe Hono API template for Bun — layered architecture, Drizzle ORM, JWT auth, and end-to-end RPC types.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test src",
    "test:integration": "bun test tests/integration",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sibobbbbbb/hono-template.git"
  },
  "keywords": [
    "hono",
    "bun",
    "typescript",
    "drizzle",
    "template",
    "rpc"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sibobbbbbb/hono-template/issues"
  },
  "homepage": "https://github.com/sibobbbbbb/hono-template#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@electric-sql/pglite": "^0.5.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.1.0",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.1.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "hono": "^4.8.10",
    "hono-pino": "^0.10.1",
    "hono-rate-limiter": "^0.4.2",
    "pino": "^9.7.0",
    "postgres": "^3.4.7",
    "zod": "^4.0.14"
  }
}
